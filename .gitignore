# Python runtime and build output
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tmp/
temp/
tmp/
build/
dist/
*.whl
*.tar.gz
*.key
*.pem
*.pfx
*.p12
